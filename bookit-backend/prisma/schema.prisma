generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Experience {
  id          String           @id @default(uuid())
  title       String
  location    String
  description String
  image       String
  price       Int
  createdAt   DateTime         @default(now())
  tax         Float
  bookings    Booking[]
  dates       ExperienceDate[]
}

model ExperienceDate {
  id           String           @id @default(uuid())
  date         DateTime
  experienceId String
  bookings     Booking[]
  experience   Experience       @relation(fields: [experienceId], references: [id])
  times        ExperienceTime[]
}

model ExperienceTime {
  id       String           @id @default(uuid())
  time     String
  dateId   String
  bookings Booking[]
  slots    ExperienceSlot[]
  date     ExperienceDate   @relation(fields: [dateId], references: [id])
}

model ExperienceSlot {
  id     String         @id @default(uuid())
  timeId String
  time   ExperienceTime @relation(fields: [timeId], references: [id])
}

model Booking {
  id           String         @id @default(uuid())
  userName     String
  userEmail    String
  quantity     Int
  promoCode    String?
  totalPrice   Int
  createdAt    DateTime       @default(now())
  dateId       String
  experienceId String
  timeId       String
  date         ExperienceDate @relation(fields: [dateId], references: [id])
  experience   Experience     @relation(fields: [experienceId], references: [id])
  time         ExperienceTime @relation(fields: [timeId], references: [id])
}
